(( $+functions[_rars_commands] )) ||
_rars_commands() {
    local commands; commands=(
'info:Display archive metadata' \
'test:Verify archive integrity by extracting to a sink' \
'extract:Extract archive contents' \
'x:Extract archive contents' \
'repair:Repair a damaged archive using its recovery record' \
'add:Create a new archive' \
'a:Create a new archive' \
    )
    _describe -t commands 'rars commands' commands "$@"
}
(( $+functions[_rars__subcmd__add_commands] )) ||
_rars__subcmd__add_commands() {
    local commands; commands=()
    _describe -t commands 'rars add commands' commands "$@"
}
(( $+functions[_rars__subcmd__extract_commands] )) ||
_rars__subcmd__extract_commands() {
    local commands; commands=()
    _describe -t commands 'rars extract commands' commands "$@"
}
(( $+functions[_rars__subcmd__info_commands] )) ||
_rars__subcmd__info_commands() {
    local commands; commands=()
    _describe -t commands 'rars info commands' commands "$@"
}
(( $+functions[_rars__subcmd__repair_commands] )) ||
_rars__subcmd__repair_commands() {
    local commands; commands=()
    _describe -t commands 'rars repair commands' commands "$@"
}
(( $+functions[_rars__subcmd__test_commands] )) ||
_rars__subcmd__test_commands() {
    local commands; commands=()
    _describe -t commands 'rars test commands' commands "$@"
}

if [ "$funcstack[1]" = "_rars" ]; then
    _rars "$@"
else
    compdef _rars rars
fi
