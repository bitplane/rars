
use builtin;
use str;

set edit:completion:arg-completer[rars] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'rars'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'rars'= {
            cand --threads 'Worker threads for parallel compression and extraction (default: all available cores)'
            cand --progress 'Progress reporting mode for long-running operations'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
            cand info 'Display archive metadata'
            cand test 'Verify archive integrity by extracting to a sink'
            cand extract 'Extract archive contents'
            cand x 'Extract archive contents'
            cand repair 'Repair a damaged archive using its recovery record'
            cand add 'Create a new archive'
            cand a 'Create a new archive'
        }
        &'rars;info'= {
            cand --legacy-name-encoding 'Source encoding for legacy names without Unicode (e.g. cp850 or detect)'
            cand --rar50-buffered-decode-limit 'Maximum RAR 5 member size to decode in memory; larger ones stream (default 16m)'
            cand --rar50-decode-workers 'Threads decoding RAR5/7 blocks ahead of the output; 0 decodes serially (default: up to 8)'
            cand --rar50-dictionary-size-limit 'Maximum declared RAR5/7 dictionary size (not total memory)'
            cand --max-member-output-bytes 'Maximum decoded output per logical member or archive comment'
            cand --max-total-output-bytes 'Maximum decoded output per extraction/test call, or per archive comment'
            cand --max-reader-workspace-bytes 'Maximum aggregate reader workspace per call (not process RAM)'
            cand --max-header-count 'Maximum top-level headers per physical archive parse'
            cand --max-header-bytes 'Maximum plaintext header bytes per physical archive parse'
            cand --rar50-scratch-dir 'Directory for RAR5 filtered decoding above the buffering threshold'
            cand --rar50-scratch-bytes 'Maximum temporary bytes for RAR5 scratch decoding'
            cand --rar50-filter-memory-limit 'Maximum workspace per RAR5 scratch filter'
            cand -p 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password-file 'Read password from file ("-" for stdin); trailing newlines are stripped'
            cand --threads 'Worker threads for parallel compression and extraction (default: all available cores)'
            cand --progress 'Progress reporting mode for long-running operations'
            cand --allow-rar3-vm 'Run RAR 3 VM filter programs other than the six standard ones. Off by default: they are arbitrary bytecode from the archive and can use a lot of CPU time. Enable only for archives you trust'
            cand -v 'Show all raw block/header fields (the developer-style dump)'
            cand --verbose 'Show all raw block/header fields (the developer-style dump)'
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
        }
        &'rars;test'= {
            cand -p 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password-file 'Read password from file ("-" for stdin); trailing newlines are stripped'
            cand --legacy-name-encoding 'Source encoding for legacy names without Unicode (e.g. cp850 or detect)'
            cand --rar50-buffered-decode-limit 'Maximum RAR 5 member size to decode in memory; larger ones stream (default 16m)'
            cand --rar50-decode-workers 'Threads decoding RAR5/7 blocks ahead of the output; 0 decodes serially (default: up to 8)'
            cand --rar50-dictionary-size-limit 'Maximum declared RAR5/7 dictionary size (not total memory)'
            cand --max-member-output-bytes 'Maximum decoded output per logical member or archive comment'
            cand --max-total-output-bytes 'Maximum decoded output per extraction/test call, or per archive comment'
            cand --max-reader-workspace-bytes 'Maximum aggregate reader workspace per call (not process RAM)'
            cand --max-header-count 'Maximum top-level headers per physical archive parse'
            cand --max-header-bytes 'Maximum plaintext header bytes per physical archive parse'
            cand --rar50-scratch-dir 'Directory for RAR5 filtered decoding above the buffering threshold'
            cand --rar50-scratch-bytes 'Maximum temporary bytes for RAR5 scratch decoding'
            cand --rar50-filter-memory-limit 'Maximum workspace per RAR5 scratch filter'
            cand --threads 'Worker threads for parallel compression and extraction (default: all available cores)'
            cand --progress 'Progress reporting mode for long-running operations'
            cand --allow-rar3-vm 'Run RAR 3 VM filter programs other than the six standard ones. Off by default: they are arbitrary bytecode from the archive and can use a lot of CPU time. Enable only for archives you trust'
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
        }
        &'rars;extract'= {
            cand -p 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password-file 'Read password from file ("-" for stdin); trailing newlines are stripped'
            cand --legacy-name-encoding 'Source encoding for legacy names without Unicode (e.g. cp850 or detect)'
            cand --rar50-buffered-decode-limit 'Maximum RAR 5 member size to decode in memory; larger ones stream (default 16m)'
            cand --rar50-decode-workers 'Threads decoding RAR5/7 blocks ahead of the output; 0 decodes serially (default: up to 8)'
            cand --rar50-dictionary-size-limit 'Maximum declared RAR5/7 dictionary size (not total memory)'
            cand --max-member-output-bytes 'Maximum decoded output per logical member or archive comment'
            cand --max-total-output-bytes 'Maximum decoded output per extraction/test call, or per archive comment'
            cand --max-reader-workspace-bytes 'Maximum aggregate reader workspace per call (not process RAM)'
            cand --max-header-count 'Maximum top-level headers per physical archive parse'
            cand --max-header-bytes 'Maximum plaintext header bytes per physical archive parse'
            cand --rar50-scratch-dir 'Directory for RAR5 filtered decoding above the buffering threshold'
            cand --rar50-scratch-bytes 'Maximum temporary bytes for RAR5 scratch decoding'
            cand --rar50-filter-memory-limit 'Maximum workspace per RAR5 scratch filter'
            cand --overwrite 'Behaviour when an extracted file already exists on disk'
            cand --threads 'Worker threads for parallel compression and extraction (default: all available cores)'
            cand --progress 'Progress reporting mode for long-running operations'
            cand --allow-rar3-vm 'Run RAR 3 VM filter programs other than the six standard ones. Off by default: they are arbitrary bytecode from the archive and can use a lot of CPU time. Enable only for archives you trust'
            cand --in-place 'Write each file at its destination instead of staging it; a failed member leaves a partial file'
            cand --keep-broken 'Keep a damaged member''s file with what could be read of it, like unrar -kb; implies --in-place'
            cand --flatten 'Write every file straight into the output directory under its base name, creating no directories'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
        }
        &'rars;x'= {
            cand -p 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password-file 'Read password from file ("-" for stdin); trailing newlines are stripped'
            cand --legacy-name-encoding 'Source encoding for legacy names without Unicode (e.g. cp850 or detect)'
            cand --rar50-buffered-decode-limit 'Maximum RAR 5 member size to decode in memory; larger ones stream (default 16m)'
            cand --rar50-decode-workers 'Threads decoding RAR5/7 blocks ahead of the output; 0 decodes serially (default: up to 8)'
            cand --rar50-dictionary-size-limit 'Maximum declared RAR5/7 dictionary size (not total memory)'
            cand --max-member-output-bytes 'Maximum decoded output per logical member or archive comment'
            cand --max-total-output-bytes 'Maximum decoded output per extraction/test call, or per archive comment'
            cand --max-reader-workspace-bytes 'Maximum aggregate reader workspace per call (not process RAM)'
            cand --max-header-count 'Maximum top-level headers per physical archive parse'
            cand --max-header-bytes 'Maximum plaintext header bytes per physical archive parse'
            cand --rar50-scratch-dir 'Directory for RAR5 filtered decoding above the buffering threshold'
            cand --rar50-scratch-bytes 'Maximum temporary bytes for RAR5 scratch decoding'
            cand --rar50-filter-memory-limit 'Maximum workspace per RAR5 scratch filter'
            cand --overwrite 'Behaviour when an extracted file already exists on disk'
            cand --threads 'Worker threads for parallel compression and extraction (default: all available cores)'
            cand --progress 'Progress reporting mode for long-running operations'
            cand --allow-rar3-vm 'Run RAR 3 VM filter programs other than the six standard ones. Off by default: they are arbitrary bytecode from the archive and can use a lot of CPU time. Enable only for archives you trust'
            cand --in-place 'Write each file at its destination instead of staging it; a failed member leaves a partial file'
            cand --keep-broken 'Keep a damaged member''s file with what could be read of it, like unrar -kb; implies --in-place'
            cand --flatten 'Write every file straight into the output directory under its base name, creating no directories'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
        }
        &'rars;repair'= {
            cand -p 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password-file 'Read password from file ("-" for stdin); trailing newlines are stripped'
            cand --threads 'Worker threads for parallel compression and extraction (default: all available cores)'
            cand --progress 'Progress reporting mode for long-running operations'
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
        }
        &'rars;add'= {
            cand -p 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password-file 'Read password from file ("-" for stdin); trailing newlines are stripped'
            cand --format 'Target archive format (default: rar50, the modern widely-compatible format)'
            cand --level 'Compression level (0..5; 0 implies --store)'
            cand --dict-size 'Dictionary size (e.g. 4m, 128k; RAR 1.5+)'
            cand --memory-limit 'Maximum total compression working memory (default: 283m, plus 160m per thread past the first, up to a quarter of RAM or the cgroup limit on Linux)'
            cand --max-memory 'Hard managed-allocation ceiling for RAR5/7, separate from estimated workspace'
            cand --temp-dir 'Directory for temporary compressed payloads (RAR 5+)'
            cand --comment 'Archive-level comment'
            cand --archive-name 'Archive name to embed in archive metadata service (RAR 5+)'
            cand --file-comment 'Per-file comment (not RAR 3.x/4.x)'
            cand --recovery-percent 'Add a recovery record at the given percentage (1..100; RAR 5+)'
            cand --volume-size 'Split archive into volumes of this size'
            cand --delta-filter 'Delta filter with the given channel count (RAR 2.9+)'
            cand --rgb-filter 'RGB image filter with the given pixel width (RAR 2.9/3.x/4.x only)'
            cand --audio-filter 'Audio filter with the given channel count (RAR 2.9/3.x/4.x only)'
            cand -C 'Read inputs from this directory and store names relative to it'
            cand --base-dir 'Read inputs from this directory and store names relative to it'
            cand --threads 'Worker threads for parallel compression and extraction (default: all available cores)'
            cand --progress 'Progress reporting mode for long-running operations'
            cand --store 'Store files without compression (equivalent to --level 0)'
            cand --solid 'Use solid compression (treats inputs as one continuous stream)'
            cand --encrypt-headers 'Encrypt archive headers (RAR 3.x/4.x and RAR 5+) (requires --password)'
            cand --quick-open 'Emit a quick-open service block (RAR 5+ only)'
            cand --blake2sp 'Store a BLAKE2sp hash of each file beside its CRC32 (RAR 5+ only)'
            cand --e8-filter 'E8 x86 call filter (RAR 2.9+)'
            cand --e8e9-filter 'E8E9 x86 call/jump filter (RAR 2.9+)'
            cand --itanium-filter 'Itanium filter (RAR 2.9/3.x/4.x only)'
            cand --arm-filter 'ARM filter (RAR 5+ only)'
            cand --auto-filter 'Auto-detect data filter (RAR 5+ does this by default)'
            cand --no-filter 'Skip filter detection, compressing the data as it is (RAR 2.9+; the older formats never look, so the flag passes without comment there)'
            cand --ppmd 'Use the PPMd compression algorithm (RAR 2.9/3.x/4.x only)'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
        }
        &'rars;a'= {
            cand -p 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password 'Archive password (visible in process list — prefer --password-file or the TTY prompt)'
            cand --password-file 'Read password from file ("-" for stdin); trailing newlines are stripped'
            cand --format 'Target archive format (default: rar50, the modern widely-compatible format)'
            cand --level 'Compression level (0..5; 0 implies --store)'
            cand --dict-size 'Dictionary size (e.g. 4m, 128k; RAR 1.5+)'
            cand --memory-limit 'Maximum total compression working memory (default: 283m, plus 160m per thread past the first, up to a quarter of RAM or the cgroup limit on Linux)'
            cand --max-memory 'Hard managed-allocation ceiling for RAR5/7, separate from estimated workspace'
            cand --temp-dir 'Directory for temporary compressed payloads (RAR 5+)'
            cand --comment 'Archive-level comment'
            cand --archive-name 'Archive name to embed in archive metadata service (RAR 5+)'
            cand --file-comment 'Per-file comment (not RAR 3.x/4.x)'
            cand --recovery-percent 'Add a recovery record at the given percentage (1..100; RAR 5+)'
            cand --volume-size 'Split archive into volumes of this size'
            cand --delta-filter 'Delta filter with the given channel count (RAR 2.9+)'
            cand --rgb-filter 'RGB image filter with the given pixel width (RAR 2.9/3.x/4.x only)'
            cand --audio-filter 'Audio filter with the given channel count (RAR 2.9/3.x/4.x only)'
            cand -C 'Read inputs from this directory and store names relative to it'
            cand --base-dir 'Read inputs from this directory and store names relative to it'
            cand --threads 'Worker threads for parallel compression and extraction (default: all available cores)'
            cand --progress 'Progress reporting mode for long-running operations'
            cand --store 'Store files without compression (equivalent to --level 0)'
            cand --solid 'Use solid compression (treats inputs as one continuous stream)'
            cand --encrypt-headers 'Encrypt archive headers (RAR 3.x/4.x and RAR 5+) (requires --password)'
            cand --quick-open 'Emit a quick-open service block (RAR 5+ only)'
            cand --blake2sp 'Store a BLAKE2sp hash of each file beside its CRC32 (RAR 5+ only)'
            cand --e8-filter 'E8 x86 call filter (RAR 2.9+)'
            cand --e8e9-filter 'E8E9 x86 call/jump filter (RAR 2.9+)'
            cand --itanium-filter 'Itanium filter (RAR 2.9/3.x/4.x only)'
            cand --arm-filter 'ARM filter (RAR 5+ only)'
            cand --auto-filter 'Auto-detect data filter (RAR 5+ does this by default)'
            cand --no-filter 'Skip filter detection, compressing the data as it is (RAR 2.9+; the older formats never look, so the flag passes without comment there)'
            cand --ppmd 'Use the PPMd compression algorithm (RAR 2.9/3.x/4.x only)'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
            cand -V 'Print version'
            cand --version 'Print version'
        }
    ]
    $completions[$command]
}
